{
  "name": "ad-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-driven, layered ad & motion studio (Remotion). Edit JSON specs, not prompts.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "sync": "node scripts/sync-specs.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/layout-utils": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@remotion/zod-types": "4.0.536",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
